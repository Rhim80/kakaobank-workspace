# naver-search 접속 정보 (자리 안내용 예시)
#
# 실제 값은 이 파일을 .env 로 복사해 채우세요 (.env는 git 무시됨 — 커밋 안 됨).
#   cp .env.example .env
# 스크립트는 ① 이 폴더(scripts/)의 .env → ② 워크스페이스 루트의 .env 순서로 찾습니다.
# (둘 중 한 곳이면 됩니다)
# 두 API는 별개 발급입니다 — 검색·트렌드만 쓰면 위 2줄, 검색량까지 쓰면 5줄 전부.

# ① NAVER API HUB (검색·트렌드·쇼핑인사이트)
#    발급: ncloud.com 가입 → NAVER API HUB → Application 만들기 →
#          쓸 API 체크(검색·검색어트렌드·쇼핑인사이트) → [인증 정보] 버튼
NAVER_APIHUB_CLIENT_ID=your_client_id_here
NAVER_APIHUB_CLIENT_SECRET=your_client_secret_here

# ② 네이버 검색광고 API (검색량·연관키워드·입찰 예상 — searchad.py)
#    발급: searchad.naver.com 가입(광고 집행 안 해도 됨) → 도구 → API 사용 관리
#    엑세스라이선스 = API_KEY, 비밀키 = SECRET_KEY, 광고계정 번호 = CUSTOMER_ID
NAVER_AD_API_KEY=your_access_license_here
NAVER_AD_SECRET_KEY=your_secret_key_here
NAVER_AD_CUSTOMER_ID=your_customer_id_here
