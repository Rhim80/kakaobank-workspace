+def _run_cloakbrowser(
+    url: str,
+    *,
+    success_selectors: Optional[list[str]],
+    timeout: int,
+) -> tuple[str, Optional[str]]:
+    """Stealth fetch via cloakbrowser (patched-Chromium, anti-bot challenge pass).
+
+    Pure-Python path: no node/npx needed. `launch()` returns a standard
+    Playwright Browser, so we reuse page.goto/page.content directly.
+
+    The binary is downloaded from cloakbrowser's official channel at install
+    time (`install.sh --with-cloak`); it is NEVER vendored into this repo —
+    cloakbrowser's BINARY-LICENSE forbids redistribution but explicitly allows
+    documenting an official-channel download.
+
+    Returns (html, error). On any failure returns ("", reason) so the caller
+    can gracefully fall through to the next fallback executor.
+    """
+    try:
+        from cloakbrowser import launch
+    except ImportError:
+        return "", "cloakbrowser not installed (run install.sh --with-cloak)"
+
+    import re as _re
+    import time as _time
+    # Interstitial title markers (Cloudflare "Just a moment...", Akamai, etc.).
+    # Title-based — body markers can persist as inert script remnants on the
+    # real page (false positive), but the <title> flips once the challenge clears.
+    _CHALLENGE_TITLE = _re.compile(
+        r"just a moment|attention required|checking|verifying|moment\.\.\.", _re.I
+    )
+    browser = None
+    try:
+        browser = launch(headless=True)
+        page = browser.new_page()
+        page.goto(url, timeout=timeout * 1000, wait_until="domcontentloaded")
+        # Caller's positive-proof selector wins when provided.
+        if success_selectors:
+            try:
+                page.wait_for_selector(success_selectors[0], timeout=12000)
+            except Exception:
+                pass  # selector may legitimately be absent; validate on content
+        else:
+            # Poll until the challenge interstitial clears (the browser solves it
+            # in the background), capped at min(20s, timeout). Without this we'd
+            # snapshot the "Just a moment..." page mid-transition.
+            deadline = _time.time() + min(20, timeout)
+            while _time.time() < deadline:
+                try:
+                    title = (page.title() or "")
+                except Exception:
+                    title = ""
+                if not _CHALLENGE_TITLE.search(title):
+                    break
+                page.wait_for_timeout(1500)
+        return page.content(), None
+    except Exception as e:
+        return "", f"{type(e).__name__}:{str(e)[:200]}"
+    finally:
+        if browser is not None:
+            try:
+                browser.close()
+            except Exception:
+                pass
+
+
